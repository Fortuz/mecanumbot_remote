<mujoco model="mecanumbot_sst">

  <!--
    Strange Situation Test (SST) world.

    A verbatim copy of `mecanumbot.xml` with the SST room furniture added: two
    chairs, a door marker, a water bowl and two floor-location markings, plus the
    owner/stranger figures recoloured so they can be told apart. The robot, the
    actor/prop pool, the arena walls and the two box obstacles are identical to
    `mecanumbot.xml` on purpose - a scenario-to-model switch in `sim.launch.py`
    loads this world only for `sst_*` scenarios, so the existing 12 scenarios keep
    the original world untouched.

    This started as a full copy rather than an `<include>` refactor; a drift guard
    test (`test_sst_model.py`) keeps the shared robot/pool bodies in step with
    `mecanumbot.xml` until the two are deduplicated.
  -->

  <compiler angle="radian"/>

  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <asset>
    <material name="dark" rgba="0.3 0.3 0.3 1"/>
    <material name="light_blue" rgba="0.1 0.1 0.5 1"/>
    <material name="green" rgba="0.0 0.8 0.0 1"/>
    <material name="orange" rgba="1.0 0.4235 0.0392 1"/>
    <material name="red" rgba="0.8 0.0 0.0 1"/>
    <material name="axis_x" rgba="0.9 0.2 0.2 1"/>
    <material name="axis_y" rgba="0.2 0.8 0.2 1"/>
    <material name="mat_surface" rgba="0.16 0.45 0.55 1"/>
    <material name="mat_goal" rgba="0.95 0.80 0.15 1"/>
    <material name="mat_start" rgba="0.25 0.62 0.35 1"/>
    <material name="cube_brick" rgba="0.72 0.30 0.20 1"/>
    <material name="limb" rgba="0.95 0.55 0.15 1"/>
    <material name="skin" rgba="0.90 0.72 0.58 1"/>
    <texture name="ground_checker" type="2d" builtin="checker" rgb1="0.82 0.84 0.86" rgb2="0.68 0.70 0.72" width="512" height="512"/>
    <material name="ground" texture="ground_checker" texrepeat="10 10" reflectance="0.05"/>

    <!--
      SST-only materials. The owner reads blue and the stranger red so the two
      figures are tellable apart in the viewer and in the RViz markers; the
      furniture materials are muted so the people stay the eye-catching things.
    -->
    <material name="owner_body" rgba="0.15 0.35 0.85 1"/>
    <material name="stranger_body" rgba="0.85 0.15 0.15 1"/>
    <material name="chair" rgba="0.45 0.33 0.22 1"/>
    <material name="door_marker" rgba="0.55 0.40 0.20 1"/>
    <material name="water_bowl" rgba="0.20 0.55 0.85 1"/>
    <material name="loc_blocks" rgba="0.80 0.65 0.20 1"/>
    <material name="loc_goal" rgba="0.30 0.65 0.40 1"/>
    <material name="toy_ball" rgba="0.90 0.35 0.65 1"/>

  </asset>

  <default>
    <default class="visual">
      <geom contype="0" conaffinity="0" density="0" group="2"/>
    </default>

    <!--
      The grabbers collide but stay out of the lidar: `mj_ray` is masked to geom
      group 0, so group 2 keeps them out of `scan` the way the visual class does,
      while contype/conaffinity let them actually grip a cube.
    -->
    <default class="grabber">
      <geom contype="1" conaffinity="1" density="0" group="2" friction="1.5 0.05 0.01"/>
    </default>

    <default class="wheel">
      <joint axis="0 0 1" limited="false" damping="0.2" frictionloss="0.05" armature="0.01"/>
      <velocity ctrllimited="true" ctrlrange="-30 30" kv="4.0"/>
    </default>
  </default>

  <worldbody>
    <light name="sun" pos="0 0 4" dir="0 0 -1" directional="true" diffuse="0.95 0.95 0.95" specular="0.25 0.25 0.25" ambient="0.35 0.35 0.35"/>
    <light name="fill" pos="2 -2 2.5" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" material="ground" friction="1.0 0.05 0.05"/>
    <geom name="x_axis_ref" type="box" pos="0.75 0 0.01" size="0.75 0.015 0.01" material="axis_x" contype="0" conaffinity="0"/>
    <geom name="y_axis_ref" type="box" pos="0 0.75 0.01" size="0.015 0.75 0.01" material="axis_y" contype="0" conaffinity="0"/>
    <geom name="wall_north" type="box" pos="0 2.0 0.25" size="2.2 0.05 0.25" material="dark"/>
    <geom name="wall_south" type="box" pos="0 -2.0 0.25" size="2.2 0.05 0.25" material="dark"/>
    <geom name="wall_east" type="box" pos="2.0 0 0.25" size="0.05 2.2 0.25" material="dark"/>
    <geom name="wall_west" type="box" pos="-2.0 0 0.25" size="0.05 2.2 0.25" material="dark"/>
    <geom name="box_obstacle_a" type="box" pos="0.9 0.4 0.15" size="0.18 0.18 0.15" material="green"/>
    <geom name="box_obstacle_b" type="box" pos="-0.7 -0.8 0.2" size="0.12 0.25 0.2" material="orange"/>

    <!--
      ====================================================================
      Strange Situation Test room furniture.
      ====================================================================

      These are static world geoms, not pool actors/props, so they appear in every
      sst_* scenario and never on /sim/actors or /sim/props - exactly like the box
      obstacles above. The chairs collide (the robot must not drive through them)
      and their legs reach into the 2D lidar plane (~0.13 m), so `scan` sees them
      as furniture. The door marker, water bowl and location patches are floor
      markings: visual-class (group 2, no collision, below the lidar plane), there
      for the viewer and to anchor the scenario coordinates.

      Layout follows Fig. 1 of the Strange Situation Test, scaled into the +/-2.0 m
      arena and kept clear of box_obstacle_a (0.9, 0.4) and box_obstacle_b
      (-0.7, -0.8):

        Chair 1 (owner)    (-0.9,  0.7)  facing Chair 2 (+x, +y)
        Chair 2 (stranger) ( 1.1,  1.0)  facing Chair 1 (-x, -y)
        Location 1 (blocks)( 1.5, -0.2)  where the cubes start
        Location 2 (goal)  (-1.5, -0.3)  where the tower is built
        Door               ( 0.3, -1.85) at the south wall; "outside" is y < -2.2
        Water bowl         (-0.3, -1.5)

      A chair is a seat slab on four legs plus a backrest. The seat sits at
      z = 0.40, the legs span the floor to the seat, and the backrest rises behind
      it. Everything is grouped under a fixed body so the whole chair can be moved
      by editing one pos; the geoms are named so the drift-guard test can assert
      they exist here and not in the base model.
    -->

    <body name="chair_1" pos="-0.9 0.7 0">
      <geom name="chair_1_seat" type="box" pos="0 0 0.40" size="0.20 0.20 0.025" material="chair"/>
      <geom name="chair_1_back" type="box" pos="-0.175 0 0.63" size="0.025 0.20 0.21" material="chair"/>
      <geom name="chair_1_leg_fl" type="box" pos="0.165 0.165 0.19" size="0.022 0.022 0.19" material="chair"/>
      <geom name="chair_1_leg_fr" type="box" pos="0.165 -0.165 0.19" size="0.022 0.022 0.19" material="chair"/>
      <geom name="chair_1_leg_bl" type="box" pos="-0.165 0.165 0.19" size="0.022 0.022 0.19" material="chair"/>
      <geom name="chair_1_leg_br" type="box" pos="-0.165 -0.165 0.19" size="0.022 0.022 0.19" material="chair"/>
    </body>

    <body name="chair_2" pos="1.1 1.0 0" quat="0 0 0 1">
      <geom name="chair_2_seat" type="box" pos="0 0 0.40" size="0.20 0.20 0.025" material="chair"/>
      <geom name="chair_2_back" type="box" pos="-0.175 0 0.63" size="0.025 0.20 0.21" material="chair"/>
      <geom name="chair_2_leg_fl" type="box" pos="0.165 0.165 0.19" size="0.022 0.022 0.19" material="chair"/>
      <geom name="chair_2_leg_fr" type="box" pos="0.165 -0.165 0.19" size="0.022 0.022 0.19" material="chair"/>
      <geom name="chair_2_leg_bl" type="box" pos="-0.165 0.165 0.19" size="0.022 0.022 0.19" material="chair"/>
      <geom name="chair_2_leg_br" type="box" pos="-0.165 -0.165 0.19" size="0.022 0.022 0.19" material="chair"/>
    </body>

    <!-- Door marker: a threshold strip on the south wall. Floor marking only. -->
    <geom name="door_marker" class="visual" type="box" pos="0.3 -1.9 0.004" size="0.35 0.06 0.004" material="door_marker"/>

    <!-- Water bowl: a short ring, floor marking only (below the lidar plane). -->
    <geom name="water_bowl" class="visual" type="cylinder" pos="-0.3 -1.5 0.02" size="0.12 0.02" material="water_bowl"/>

    <!-- Location patches: where the blocks start (1) and where they go (2). -->
    <geom name="location_1" class="visual" type="box" pos="1.5 -0.2 0.004" size="0.25 0.30 0.004" material="loc_blocks"/>
    <geom name="location_2" class="visual" type="box" pos="-1.5 -0.3 0.004" size="0.25 0.30 0.004" material="loc_goal"/>

    <!--
      Scenario actors. A person is an articulated figure: the root body carries no
      geom and marks the actor's ground pose (that is what `/sim/actors` publishes),
      and six further mocap bodies are its segments, each defined about its own
      pivot at the body origin so the runtime only has to supply a pose:

        torso_lower  hip -> chest, pivot at the spine base, grows along +z
        torso_upper  chest -> crown (carries the head), bends relative to the lower
                     A cylinder, not a capsule, and deliberately: a capsule's top
                     cap bulges 0.145 above the crown, which swallowed all but
                     20 mm of the head sphere and left the figure looking
                     headless in the viewer. Flat-topped is also what the Gazebo
                     SDF and the RViz markers draw, so all three now agree.
        arm_left/right   hang along -z from the shoulders, which ride on the upper torso
        leg_left/right   hang along -z from the hips, which ride on the root

      Two bendable spine segments plus four limbs is what lets the exercise moves in
      `sim_actor_runtime.py` read as aerobics rather than as a sliding stick figure.
      Only the legs matter to the 2D lidar, which sits at about 0.13 m and slices
      them between 0.05 and 0.55 m; everything above that is for the viewer.

      SST only recolours the figures: sim_human_0 (owner) blue, sim_human_1
      (stranger) red. The segment geometry and dimensions are unchanged, so the
      forward kinematics in `sim_actor_runtime.py` and the constants in
      `sim_scenarios.py` still match.
    -->

    <body name="sim_human_0" mocap="true" pos="25.0 25 0"/>

    <body name="sim_human_0_torso_lower" mocap="true" pos="25.0 25 0.45">
      <geom name="sim_human_0_torso_lower_geom" type="capsule" fromto="0 0 0 0 0 0.4" size="0.16" material="owner_body"/>
    </body>

    <body name="sim_human_0_torso_upper" mocap="true" pos="25.0 25 0.8500000000000001">
      <geom name="sim_human_0_torso_upper_geom" type="cylinder" fromto="0 0 0 0 0 0.3" size="0.145" material="owner_body"/>
      <geom name="sim_human_0_head_geom" type="sphere" pos="0 0 0.38" size="0.085" material="skin"/>
    </body>

    <body name="sim_human_0_arm_left" mocap="true" pos="25.0 25.17 1.09">
      <geom name="sim_human_0_arm_left_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.05" material="owner_body"/>
    </body>

    <body name="sim_human_0_arm_right" mocap="true" pos="25.0 24.83 1.09">
      <geom name="sim_human_0_arm_right_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.05" material="owner_body"/>
    </body>

    <body name="sim_human_0_leg_left" mocap="true" pos="25.0 25.11 0.55">
      <geom name="sim_human_0_leg_left_geom" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.06" material="owner_body"/>
    </body>

    <body name="sim_human_0_leg_right" mocap="true" pos="25.0 24.89 0.55">
      <geom name="sim_human_0_leg_right_geom" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.06" material="owner_body"/>
    </body>

    <body name="sim_wall_panel_0" mocap="true" pos="26.0 25 0">
      <geom name="sim_wall_panel_0_geom" type="box" pos="0 0 0.6" size="0.55 0.05 0.6" material="dark"/>
    </body>

    <body name="sim_human_1" mocap="true" pos="27.0 25 0"/>

    <body name="sim_human_1_torso_lower" mocap="true" pos="27.0 25 0.45">
      <geom name="sim_human_1_torso_lower_geom" type="capsule" fromto="0 0 0 0 0 0.4" size="0.16" material="stranger_body"/>
    </body>

    <body name="sim_human_1_torso_upper" mocap="true" pos="27.0 25 0.8500000000000001">
      <geom name="sim_human_1_torso_upper_geom" type="cylinder" fromto="0 0 0 0 0 0.3" size="0.145" material="stranger_body"/>
      <geom name="sim_human_1_head_geom" type="sphere" pos="0 0 0.38" size="0.085" material="skin"/>
    </body>

    <body name="sim_human_1_arm_left" mocap="true" pos="27.0 25.17 1.09">
      <geom name="sim_human_1_arm_left_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.05" material="stranger_body"/>
    </body>

    <body name="sim_human_1_arm_right" mocap="true" pos="27.0 24.83 1.09">
      <geom name="sim_human_1_arm_right_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.05" material="stranger_body"/>
    </body>

    <body name="sim_human_1_leg_left" mocap="true" pos="27.0 25.11 0.55">
      <geom name="sim_human_1_leg_left_geom" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.06" material="stranger_body"/>
    </body>

    <body name="sim_human_1_leg_right" mocap="true" pos="27.0 24.89 0.55">
      <geom name="sim_human_1_leg_right_geom" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.06" material="stranger_body"/>
    </body>

    <body name="sim_wall_panel_1" mocap="true" pos="28.0 25 0">
      <geom name="sim_wall_panel_1_geom" type="box" pos="0 0 0.6" size="0.55 0.05 0.6" material="dark"/>
    </body>

    <!--
      Scenario props. Mats are mocap (kinematic, non-colliding floor markings);
      cubes are free bodies the robot can shove around and grip. Both pools are
      parked out of the arena and are moved into place by `load_props` when a
      scenario names them; `size`/`mass` from the scenario rewrite geom_size /
      body_mass, so the numbers below are only the defaults.

      The mat default is a yoga mat: 1.73 x 0.61 m, 6 mm thick, long axis along
      the body's x. The cube default is 0.07 m, which is what makes it grippable:
      the grabber shafts sit at z ~ 0.034 with a 0.116 m clear gap between them, so
      a 0.07 m cube reaches into the shaft band and still leaves 23 mm a side to
      close on.
    -->
    <body name="sim_mat_0" mocap="true" pos="30 25 0">
      <geom name="sim_mat_0_geom" class="visual" type="box" pos="0 0 0.003" size="0.865 0.305 0.003" material="mat_surface"/>
    </body>

    <body name="sim_mat_1" mocap="true" pos="32 25 0">
      <geom name="sim_mat_1_geom" class="visual" type="box" pos="0 0 0.003" size="0.865 0.305 0.003" material="mat_goal"/>
    </body>

    <body name="sim_mat_2" mocap="true" pos="34 25 0">
      <geom name="sim_mat_2_geom" class="visual" type="box" pos="0 0 0.003" size="0.865 0.305 0.003" material="mat_start"/>
    </body>

    <body name="sim_cube_0" pos="3.0 3.0 0.035">
      <freejoint name="sim_cube_0_free"/>
      <inertial pos="0 0 0" mass="0.15" diaginertia="0.0001225 0.0001225 0.0001225"/>
      <geom name="sim_cube_0_geom" type="box" size="0.035 0.035 0.035" material="cube_brick" friction="0.6 0.02 0.01"/>
    </body>

    <body name="sim_cube_1" pos="3.4 3.0 0.035">
      <freejoint name="sim_cube_1_free"/>
      <inertial pos="0 0 0" mass="0.15" diaginertia="0.0001225 0.0001225 0.0001225"/>
      <geom name="sim_cube_1_geom" type="box" size="0.035 0.035 0.035" material="cube_brick" friction="0.6 0.02 0.01"/>
    </body>

    <body name="sim_cube_2" pos="3.8 3.0 0.035">
      <freejoint name="sim_cube_2_free"/>
      <inertial pos="0 0 0" mass="0.15" diaginertia="0.0001225 0.0001225 0.0001225"/>
      <geom name="sim_cube_2_geom" type="box" size="0.035 0.035 0.035" material="cube_brick" friction="0.6 0.02 0.01"/>
    </body>

    <body name="sim_cube_3" pos="4.2 3.0 0.035">
      <freejoint name="sim_cube_3_free"/>
      <inertial pos="0 0 0" mass="0.15" diaginertia="0.0001225 0.0001225 0.0001225"/>
      <geom name="sim_cube_3_geom" type="box" size="0.035 0.035 0.035" material="cube_brick" friction="0.6 0.02 0.01"/>
    </body>

    <!--
      SST toy ball: a free body the dog (robot) can nudge and roll, parked off the
      arena until a scenario names it (load_props moves it in).
    -->
    <body name="sim_ball_0" pos="4.6 3.0 0.09">
      <freejoint name="sim_ball_0_free"/>
      <inertial pos="0 0 0" mass="0.08" diaginertia="0.00026 0.00026 0.00026"/>
      <geom name="sim_ball_0_geom" type="sphere" size="0.09" material="toy_ball" friction="0.4 0.02 0.01"/>
    </body>

    <body name="base_link" pos="0 0 0.06">
      <inertial pos="0 0 0.06" mass="3.0" diaginertia="0.04 0.04 0.04"/>
      <joint name="base_free" type="free"/>

      <geom type="box" pos="0 0 0.055" size="0.16 0.13 0.03" material="dark" friction="1.0 0.05 0.05"/>
      <geom type="box" pos="0.09 0 0.12" size="0.055 0.11 0.04" material="dark" class="visual"/>

      <body name="wheel_frontleft" pos="0.064 0.1522 0.02345" quat="0.707 0.707 0 0">
        <inertial pos="0 0 0" mass="0.15" diaginertia="0.0002 0.0002 0.0002"/>
        <joint name="wheel_frontleft_joint" class="wheel"/>
        <geom type="cylinder" size="0.034 0.018" material="light_blue" friction="1.2 0.05 0.05"/>
      </body>

      <body name="wheel_backleft" pos="-0.064 0.1522 0.02345" quat="0.707 0.707 0 0">
        <inertial pos="0 0 0" mass="0.15" diaginertia="0.0002 0.0002 0.0002"/>
        <joint name="wheel_backleft_joint" class="wheel"/>
        <geom type="cylinder" size="0.034 0.018" material="light_blue" friction="1.2 0.05 0.05"/>
      </body>

      <body name="wheel_frontright" pos="0.064 -0.1522 0.02345" quat="0.707 -0.707 0 0">
        <inertial pos="0 0 0" mass="0.15" diaginertia="0.0002 0.0002 0.0002"/>
        <joint name="wheel_frontright_joint" class="wheel"/>
        <geom type="cylinder" size="0.034 0.018" material="light_blue" friction="1.2 0.05 0.05"/>
      </body>

      <body name="wheel_backright" pos="-0.064 -0.1522 0.02345" quat="0.707 -0.707 0 0">
        <inertial pos="0 0 0" mass="0.15" diaginertia="0.0002 0.0002 0.0002"/>
        <joint name="wheel_backright_joint" class="wheel"/>
        <geom type="cylinder" size="0.034 0.018" material="light_blue" friction="1.2 0.05 0.05"/>
      </body>

      <!--
        The two grabbers are a mirrored servo pair, so the left joint's axis is
        flipped: one commanded angle closes both, which is what `gl_pos == gr_pos`
        means on the real robot. Positive angle = closing. The shafts sit at
        z ~ 0.034 with the robot settled, so they grip a cube by its sides near the
        floor - this is a horizontal pincer, it has no lift degree of freedom.
      -->
      <body name="grabber_right" pos="0.174 -0.070 0.024">
        <inertial pos="0.05 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="grabber_right_joint" axis="0 0 1" range="-1.57 1.57" limited="true" damping="0.2"/>
        <geom name="grabber_right_geom" type="capsule" fromto="0 0 0 0.10 0 0" size="0.012" material="green" class="grabber"/>
      </body>

      <body name="grabber_left" pos="0.174 0.070 0.024">
        <inertial pos="0.05 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="grabber_left_joint" axis="0 0 -1" range="-1.57 1.57" limited="true" damping="0.2"/>
        <geom name="grabber_left_geom" type="capsule" fromto="0 0 0 0.10 0 0" size="0.012" material="green" class="grabber"/>
      </body>

      <body name="head" pos="0.1063 0 0.170" quat="0.707 0.707 0 0">
        <inertial pos="0 0 0" mass="0.08" diaginertia="0.0002 0.0002 0.0002"/>
        <joint name="head_joint" range="-1.57 1.57" limited="true" damping="0.2"/>
        <geom type="box" size="0.02 0.03 0.02" material="orange" class="visual"/>

        <body name="camera" pos="0.022 0.0545 0">
          <geom type="box" size="0.0075 0.015 0.0135" material="red" class="visual"/>
        </body>
      </body>

      <body name="base_scan" pos="0 0 0.122">
        <geom type="cylinder" size="0.055 0.015" material="dark" class="visual"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="bl" joint="wheel_backleft_joint"/>
    <velocity name="br" joint="wheel_backright_joint"/>
    <velocity name="fl" joint="wheel_frontleft_joint"/>
    <velocity name="fr" joint="wheel_frontright_joint"/>
    <!-- kp high enough that a closed grabber actually holds a cube against drag. -->
    <position name="grabber_left" joint="grabber_left_joint" kp="12.0"/>
    <position name="grabber_right" joint="grabber_right_joint" kp="12.0"/>
    <position name="head" joint="head_joint"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="wheel_frontleft"/>
    <exclude body1="base_link" body2="wheel_frontright"/>
    <exclude body1="base_link" body2="wheel_backleft"/>
    <exclude body1="base_link" body2="wheel_backright"/>
  </contact>

</mujoco>
